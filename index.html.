  }

  .checkin-box:hover {
    transform: translateY(-3px);
  }

  .checkin-box h3 {
    margin: 0 0 8px 0;
    text-transform: uppercase;
    font-size: 15px;
  }

  .checkin-box p {
    margin: 0;
    font-size: 14px;
  }

  .circle-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 16px 0 24px 0;
  }

  @media (max-width: 800px) {
    .checkin-grid, .circle-steps { grid-template-columns: 1fr; }
  }

  /* Examinations & Content Cards */
  .exam-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 12px;
  }

  .three-col-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .exam-cards, .three-col-cards { grid-template-columns: 1fr; }
  }

  .exam-card {
    background: #121212;
    border: 1.5px solid #fff;
    border-radius: 6px;
    padding: 18px;
  }

  .exam-card h3 {
    margin: 0 0 8px 0;
    color: var(--accent);
    font-size: 15px;
    text-transform: uppercase;
  }

  .grade-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: bold;
    font-size: 11px;
    margin-right: 6px;
  }

  /* Interactive Slide Stepper for Lesson 2 */
  .slide-nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 12px 0 18px 0;
  }

  .slide-pill {
    background: #161616;
    color: #fff;
    border: 1.5px solid #555;
    padding: 7px 13px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.15s;
  }

  .slide-pill:hover {
    border-color: #fff;
  }

  .slide-pill.active {
    background: var(--gold);
    border-color: #fff;
  }

  .l2-slide {
    display: none;
  }

  .l2-slide.active {
    display: block;
  }

  .blackbox-flow {
    display: grid;
    grid-template-columns: 1fr auto 1.3fr auto 1fr;
    gap: 10px;
    align-items: center;
    margin: 16px 0;
  }

  @media (max-width: 850px) {
    .blackbox-flow { grid-template-columns: 1fr; }
    .arrow-sep { display: none; }
  }

  .arrow-sep {
    font-size: 26px;
    font-weight: bold;
    color: var(--accent);
    text-align: center;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 14px;
  }

  @media (max-width: 1000px) {
    .timeline-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
