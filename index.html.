  function openLesson(num) {
    const data = lessonData[num];
    if (!data) return;
    const header = document.getElementById('modal-header');
    header.className = 'modal-header ' + data.color;
    document.getElementById('modal-title').textContent = data.date + " – " + data.title;
    document.getElementById('modal-desc').textContent = data.desc;
    document.getElementById('modal-lit').textContent = data.lit;
    document.getElementById('modal-workshop').textContent = data.workshop;
    document.getElementById('modal-goal').textContent = data.goal;
    document.getElementById('modal-badge').textContent = data.badge;
    document.getElementById('lesson-modal').classList.add('open');
  }

  function closeModal() {
    document.getElementById('lesson-modal').classList.remove('open');
  }

  function filterCategory(cat, el) {
    document.querySelectorAll('.legend-item').forEach(item => item.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('#view-overview .box').forEach(box => {
      if (cat === 'all' || box.getAttribute('data-cat') === cat) {
        box.classList.remove('dimmed');
      } else {
        box.classList.add('dimmed');
      }
    });
  }

  function switchView(viewId, btn) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById('view-' + viewId).classList.add('active');
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function switchL2Slide(num, btn) {
    document.querySelectorAll('.l2-slide').forEach(s => s.classList.remove('active'));
    document.getElementById('l2-slide-' + num).classList.add('active');
    document.querySelectorAll('.slide-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
function switchL3Slide(num, btn) {
    document.querySelectorAll('.l3-slide').forEach(s => s.style.display = 'none');
    document.getElementById('l3-slide-' + num).style.display = 'block';
    document.querySelectorAll('.l3-nav-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
  }
</script>
