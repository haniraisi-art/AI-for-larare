  }

  /* Lesson 1 & 2 Check-in & Circle View */
  .checkin-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 14px;
  }

  .checkin-box {
    background-color: var(--orange);
    border: 2px solid #fff;
    border-radius: 6px;
    padding: 18px;
    cursor: pointer;
