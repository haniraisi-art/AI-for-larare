<html lang="sv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kursöversikt – AI för lärare och pedagoger (40 YH-p)</title>
<style>
  :root {
    --bg: #000000;
    --card-bg: #111111;
    --text: #ffffff;
    --muted: #b0b0b0;
    --orange: #E84C22;
    --blue: #2B78E4;
    --purple: #8E44AD;
    --green: #27AE60;
    --gold: #D68910;
    --accent: #f39c12;
  }

  * { box-sizing: border-box; }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    margin: 0;
    padding: 24px 32px;
    line-height: 1.45;
  }

  /* Header & Navigation */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    border-bottom: 1px solid #2a2a2a;
    padding-bottom: 16px;
    margin-bottom: 18px;
  }

  h1 {
    text-transform: uppercase;
    font-size: 24px;
    margin: 0 0 4px 0;
    letter-spacing: 1px;
  }

  p.sub {
    color: var(--muted);
    margin: 0;
    font-size: 14px;
  }

  .nav-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tab-btn {
    background: #181818;
    color: #fff;
    border: 1.5px solid #444;
    padding: 8px 14px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tab-btn:hover {
    border-color: #fff;
  }

  .tab-btn.active {
    background: var(--orange);
    border-color: #fff;
  }

  /* Views */
  .view { display: none; }
  .view.active { display: block; }

  /* Section Titles */
  .section-title {
    font-size: 15px;
    font-weight: bold;
    color: var(--accent);
    margin: 18px 0 10px 0;
    text-transform: uppercase;
    border-bottom: 1px solid #333;
    padding-bottom: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-title span.meta {
    font-size: 12px;
    color: var(--muted);
    text-transform: none;
    font-weight: normal;
  }

  /* 5-Column Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
  }

  .box {
    border: 1.5px solid #ffffff;
    padding: 12px;
    border-radius: 4px;
    text-align: center;
    transition: transform 0.15s, opacity 0.2s, box-shadow 0.15s;
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 108px;
  }

  .box:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 20px rgba(255,255,255,0.18);
    z-index: 2;
  }

  .box.dimmed {
    opacity: 0.2;
    transform: scale(0.98);
  }

  .date {
    font-size: 11px;
    font-weight: bold;
    opacity: 0.92;
    text-transform: uppercase;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
  }

  .title {
    font-size: 13px;
    font-weight: bold;
    line-height: 1.3;
    margin: 4px 0;
  }

  .badge {
    display: inline-block;
    margin-top: 6px;
    font-size: 10px;
    background: rgba(0,0,0,0.42);
    padding: 3px 7px;
    border-radius: 3px;
    align-self: center;
  }

  .orange { background-color: var(--orange); }
  .blue   { background-color: var(--blue); }
  .purple { background-color: var(--purple); }
  .green  { background-color: var(--green); }
  .gold   { background-color: var(--gold); }

  /* Interactive Legend */
  .legend-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid #222;
    gap: 12px;
  }

  .legend {
    display: flex;
    gap: 12px;
    font-size: 12px;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 4px;
    border: 1px solid transparent;
    background: #121212;
    transition: all 0.15s;
  }

  .legend-item:hover, .legend-item.active {
    border-color: #fff;
    background: #222;
  }

  .dot {
    width: 14px;
    height: 14px;
    display: inline-block;
    border: 1px solid #fff;
    border-radius: 2px;
  }

  .hint-text {
    font-size: 12px;
    color: var(--muted);
  }

  /* Modal Popup for Lesson Details */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.82);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 100;
  }

  .modal-backdrop.open {
    display: flex;
  }

  .modal {
    background: #0d0d0d;
    border: 2px solid #ffffff;
    border-radius: 6px;
    max-width: 680px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.9);
  }

  .modal-header {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid #fff;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 18px;
    text-transform: uppercase;
  }

  .close-btn {
    background: rgba(0,0,0,0.45);
    color: #fff;
    border: 1px solid #fff;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    font-weight: bold;
  }

  .modal-body {
